{
    "max_input_length": 500,
    "min_input_length": 3,
    "dataset_url": "https://storage.googleapis.com/tensorflow-1-public/course3/sarcasm.json",
    "dataset_url_fallback": "https://raw.githubusercontent.com/divye-joshi/sarcasm-prediction-with-BERT/main/Sarcasm_Headlines_Dataset_v2.json",
    "test_split": 0.15,
    "val_split": 0.15,
    "random_seed": 42,
    "tfidf_max_features": 10000,
    "tfidf_ngram_range": [1, 2],
    "logistic_regression_C": 1.0,
    "logistic_regression_max_iter": 1000,
    "emotion_model_name": "j-hartmann/emotion-english-distilroberta-base",
    "emotion_batch_size": 64,
    "flask_host": "0.0.0.0",
    "flask_port": 5000,
    "flask_debug": false
}
